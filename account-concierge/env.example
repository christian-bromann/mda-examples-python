# Model provider (must match agent.py) — required for local runs.
OPENAI_API_KEY=

# If your shell exports OPENAI_BASE_URL to LangSmith Gateway
# (https://gateway.smith.langchain.com/...), either unset it or set this so
# the sk-proj key hits api.openai.com. `make agent` / `make dev` also force this.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Shared secret for trusted-backend ingress (Account Concierge) — required for local runs.
# Same value in mda dev / deploy AND in the proxy process.
# Never send this from the browser.
MDA_INGRESS_SECRET=

# LangSmith — only needed for `mda deploy` (and LangGraph Studio).
# Not required for the local proxy demo.
# LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=

# Optional: where the proxy forwards LangGraph traffic.
# Default is http://127.0.0.1:2024. Use http://[::1]:2024 if the agent
# only listens on IPv6 loopback.
# LANGGRAPH_API_URL=http://127.0.0.1:2024
# PROXY_PORT=4910
